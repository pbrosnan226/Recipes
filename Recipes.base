filters:
  and:
    - file.hasTag("recipe")
properties:
  file.name:
    displayName: Recipe
  note.tags:
    displayName: Tags
  note.site:
    displayName: Site
  note.author:
    displayName: Author
  note.servings:
    displayName: Servings
  note.prep_time:
    displayName: Prep
  note.cook_time:
    displayName: Cook
  note.total_time:
    displayName: Total
  note.total_minutes:
    displayName: Total (min)
  note.created:
    displayName: Added
views:
  - type: table
    name: All recipes
    order:
      - file.name
      - tags
      - site
      - author
      - servings
      - prep_time
      - cook_time
      - total_time
      - total_minutes
      - created
    sort:
      - property: site
        direction: ASC
      - property: file.name
        direction: ASC
